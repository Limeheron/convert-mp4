#!/bin/bash
#
# convert_mp4 — 영상 파일(주로 MKV)의 컨테이너만 MP4로 바꾼다. 재인코딩은 하지 않는다.
#
# 사용법: convert_mp4 파일 [파일 ...]
#   예) convert_mp4 녹화.mkv
#       convert_mp4 ~/Movies/*.mkv
#
# 결과물은 원본과 같은 폴더에 "이름.mp4"로 만든다. 같은 이름이 있으면 이름_1.mp4, 이름_2.mp4 …
# 원본 파일은 어떤 경우에도 수정하거나 지우지 않는다.
#
# 영상·음향 무결성
#  - 모든 비디오·오디오 트랙을 비트 단위 그대로 복사한다. ffmpeg 기본 동작과 달리 트랙을
#    하나씩만 고르지 않고, 파일 맨 앞의 키프레임 이전 프레임도 버리지 않는다.
#  - 타임스탬프를 바꾸는 옵션은 쓰지 않는다. 트랙 간 싱크는 원본 그대로다.
#  - 변환 후 원본과 결과물의 트랙별 데이터 해시를 비교한다. 패킷 형식만 바뀌는 경우
#    (MPEG-TS 등)는 디코딩한 영상 프레임·음향 샘플끼리 비교한다. 다르면 결과물을 지운다.
#
# 메타데이터
#  - 촬영 일시(creation_time), 제목·설명 같은 표준 태그, 트랙별 언어·이름, 기본 트랙 지정,
#    챕터, 커버 이미지(JPEG/PNG/BMP)를 옮긴다.
#  - MP4 표준에 없는 커스텀 태그는 옮길 수 없어 이름을 알려 준다.
#    (mdta 방식으로 억지로 넣으면 ffmpeg가 나중에 촬영 일시를 읽지 못하게 된다.)
#  - 파일의 생성일·수정일과 Finder 태그·코멘트를 원본과 같게 맞춘다.
#  - MP4에 그대로 넣을 수 없는 자막(SRT/ASS/SSA/VTT/PGS)은 "이름.kor.srt"처럼
#    옆에 별도 파일로 그대로 꺼내 둔다.
#
# Final Cut Pro
#  - HEVC는 Apple 호환 태그(hvc1)로 저장한다. ffmpeg 기본값(hev1)은 FCP·QuickTime이 열지 못한다.
#  - FCP가 지원하지 않는 코덱(VP9, AV1, Opus, AC3 등)이면 경고한다.
#    이 경우는 컨테이너만 바꿔서는 해결되지 않고 재인코딩이 필요하다.

# 데이터와 무관하게 자주 나오는 ffmpeg 안내성 경고 (화면에 보여 주지 않는다)
FFMPEG_BENIGN='codec frame size is not set|Could not find codec parameters for stream|increasing the value for the .analyzeduration|Guessed Channel Layout|UDTA parsing failed retrying raw|Last message repeated'

usage() {
    echo "사용법: $0 파일 [파일 ...]"
}

# 폴더, 이름, 확장자 → 아직 없는 경로 (이름.확장자, 이름_1.확장자, 이름_2.확장자 …)
unique_path() {
    local path="$1/$2.$3" n=1
    while [ -e "$path" ]; do
        path="$1/$2_$n.$3"
        n=$((n + 1))
    done
    echo "$path"
}

# 스트림 목록을 "번호|종류|코덱|커버여부|언어|첨부파일명" 줄로 출력한다.
# flat 형식을 쓰는 이유: MPEG-TS는 같은 스트림이 프로그램 항목에도 한 번 더 나오는데,
# flat 형식에서만 실제 스트림 항목(streams.stream.N.*)을 확실히 구분할 수 있다.
probe_streams() {
    local raw
    raw=$(ffprobe -v error \
        -show_entries stream=index,codec_type,codec_name:stream_disposition=attached_pic:stream_tags=language,filename \
        -of flat "file:$1") || return 1
    awk '
        /^streams\.stream\.[0-9]+\./ {
            sub(/^streams\.stream\./, "")
            n = $0;   sub(/\..*/, "", n)
            key = $0; sub(/^[0-9]+\./, "", key); sub(/=.*/, "", key)
            val = $0; sub(/^[^=]*=/, "", val);   gsub(/^"|"$/, "", val)
            if (!(n in seen)) { seen[n] = 1; order[++count] = n }
            field[n, key] = val
        }
        END {
            if (!count) exit 1
            for (i = 1; i <= count; i++) {
                n = order[i]
                printf "%s|%s|%s|%s|%s|%s\n", field[n, "index"], field[n, "codec_type"], field[n, "codec_name"],
                    field[n, "disposition.attached_pic"], field[n, "tags.language"], field[n, "tags.filename"]
            }
        }' <<< "$raw"
}

# 전역 태그 이름을 한 줄에 하나씩 출력한다
global_tag_keys() {
    ffprobe -v error -show_entries format_tags -of default=nw=1 "file:$1" |
        sed -n 's/^TAG:\([^=]*\)=.*/\1/p'
}

# Final Cut Pro 호환 경고 문구 (문제없는 코덱이면 출력 없음)
fcp_note() {   # 종류 코덱
    case "$1:$2" in
        video:h264|video:hevc|audio:aac|audio:mp3|audio:alac) ;;
        audio:pcm_*) echo "MP4 안의 PCM은 Final Cut Pro가 인식하지 못할 수 있음 (MOV 컨테이너가 적합)" ;;
        *)           echo "Final Cut Pro에서 지원되지 않을 수 있음 — 컨테이너만 바꿔서는 해결되지 않고 재인코딩이 필요" ;;
    esac
}

# 트랙별 해시를 "순번,종류,murmur3=…" 줄로 출력한다
#   copy   : 압축된 패킷 데이터 그대로 (빠름)
#   decode : 디코딩한 영상 프레임·음향 샘플 (느림. 패킷 형식만 바뀐 경우용)
# 결과물(MP4)은 edit list 와 상관없이 저장된 샘플 전체를 읽는다.
stream_hashes() {   # copy|decode in|out 파일 스트림번호...
    local mode=$1 role=$2 file=$3 idx
    shift 3
    local args=(-nostdin -v error)
    [ "$role" = out ] && args+=(-ignore_editlist 1)
    args+=(-i "file:$file")
    for idx in "$@"; do
        args+=(-map "0:$idx")
    done
    if [ "$mode" = copy ]; then
        args+=(-c copy -copyinkf)
    else
        args+=(-fps_mode:v passthrough -stats)
    fi
    ffmpeg "${args[@]}" -f streamhash -hash murmur3 -
}

# 트랙 간 시작 시각 관계가 원본보다 얼마나 어긋났는지 ms 로 출력한다 (0 이면 싱크 동일)
sync_drift_ms() {   # 원본 결과물 "원본번호들" "결과번호들"
    {
        ffprobe -v error -show_entries stream=index,start_time -of csv=p=0 "file:$1" | sed 's/^/in,/'
        ffprobe -v error -show_entries stream=index,start_time -of csv=p=0 "file:$2" | sed 's/^/out,/'
    } | awk -F, -v src="$3" -v dst="$4" '
        { start[$1 "," $2] = $3 }
        END {
            n = split(src, a, " "); split(dst, b, " ")
            for (k = 1; k <= n; k++) {
                x = start["in," a[k]]; y = start["out," b[k]]
                if (x == "" || y == "" || x == "N/A" || y == "N/A") continue
                d = y - x
                if (c == 0) { lo = d; hi = d } else { if (d < lo) lo = d; if (d > hi) hi = d }
                c++
            }
            printf "%d\n", c ? (hi - lo) * 1000 + 0.5 : 0
        }'
}

# 파일 시스템 정보(생성일·수정일, Finder 태그·코멘트 등)를 원본과 같게 맞춘다
copy_file_info() {   # 원본 대상
    local src=$1 dst=$2 attr birth
    xattr "$src" 2>/dev/null | grep '^com\.apple\.metadata:' | while IFS= read -r attr; do
        xattr -wx "$attr" "$(xattr -px "$attr" "$src")" "$dst"
    done
    # 수정일을 생성일보다 과거로 설정하면 macOS가 생성일도 그 시각으로 당긴다.
    # 그래서 원본 생성일 → 원본 수정일 순서로 두 번 설정한다.
    birth=$(/usr/bin/stat -f %B "$src")
    if [ "${birth:-0}" -gt 0 ]; then
        TZ=UTC0 /usr/bin/touch -t "$(TZ=UTC0 /bin/date -r "$birth" +%Y%m%d%H%M.%S)" "$dst"
    fi
    /usr/bin/touch -r "$src" "$dst"
}

discard_partial() {
    rm -f -- "$partial"
    partial=
}

# 파일 하나를 변환한다. 반환값: 0 성공, 2 성공(경고 있음), 1 실패
convert_one() {
    local in=$1
    case "$in" in /*|./*|../*) ;; *) in="./$in" ;; esac   # '-'나 ':'가 든 이름도 안전하게
    if [ ! -f "$in" ]; then
        echo "❌ 파일이 없습니다: $1"
        return 1
    fi

    local dir=${in%/*} filename=${in##*/}
    [ -n "$dir" ] || dir=/
    local name=${filename%.*}
    [ -n "$name" ] || name=$filename
    if [ ! -w "$dir" ]; then
        echo "❌ 폴더에 쓰기 권한이 없습니다: $dir"
        return 1
    fi

    local out
    out=$(unique_path "$dir" "$name" mp4)
    [ "$out" = "$dir/$name.mp4" ] || echo "⚠️ 경고: '$dir/$name.mp4' 파일이 이미 존재합니다."
    echo "▶ 변환 시작: $in -> $out"

    # --- 트랙 분석 ---
    local streams
    if ! streams=$(probe_streams "$in"); then
        echo "❌ 영상 파일로 읽을 수 없습니다."
        return 1
    fi

    local chapters
    chapters=$(ffprobe -v error -show_entries chapter=id -of csv=p=0 "file:$in" | grep -c .)

    local maps=() covers=() hvc1=() src_va=() src_covers=() subs=() excluded=()
    local idx kind codec pic lang fname label note item n=0 warned=0
    while IFS='|' read -r idx kind codec pic lang fname; do
        case "$kind:$pic" in
            video:1)                                   # MKV에 첨부된 커버 이미지
                case "$codec" in
                    mjpeg|png|bmp)
                        covers+=(-map "0:$idx")
                        src_covers+=("$idx")
                        echo "   커버 이미지 #$idx: $codec" ;;
                    *)  excluded+=("커버 이미지 #$idx ($codec)") ;;
                esac
                ;;
            video:*|audio:*)
                maps+=(-map "0:$idx")
                src_va+=("$idx")
                if [ "$kind" = video ]; then label=비디오; else label=오디오; fi
                echo "   $label #$idx: $codec${lang:+ ($lang)}"
                [ "$codec" = hevc ] && hvc1+=("-tag:$n" hvc1)
                note=$(fcp_note "$kind" "$codec")
                if [ -n "$note" ]; then
                    echo "      ⚠️ $note"
                    warned=1
                fi
                n=$((n + 1))
                ;;
            subtitle:*)
                case "$codec" in
                    mov_text)                          # MP4 표준 자막은 그대로 넣는다
                        maps+=(-map "0:$idx")
                        n=$((n + 1))
                        echo "   자막 #$idx: $codec${lang:+ ($lang)}" ;;
                    subrip|ass|ssa|webvtt|hdmv_pgs_subtitle)
                        subs+=("$idx:$codec:${lang:-und}")
                        echo "   자막 #$idx: $codec${lang:+ ($lang)} → 별도 파일로 저장" ;;
                    *)  excluded+=("자막 #$idx ($codec)") ;;
                esac
                ;;
            attachment:*) excluded+=("첨부 파일 #$idx${fname:+ ($fname)}") ;;
            data:*)
                # MP4/MOV 입력의 챕터 트랙(텍스트)이면 알리지 않는다. 챕터는 -map_chapters 로 옮겨진다.
                [ "$codec" = bin_data ] && [ "$chapters" -gt 0 ] && continue
                excluded+=("데이터 트랙 #$idx${codec:+ ($codec)}") ;;
            *)            excluded+=("$kind 트랙 #$idx${codec:+ ($codec)}") ;;
        esac
    done <<< "$streams"

    for item in "${excluded[@]}"; do
        echo "   ⏭  $item: MP4에 넣을 수 없어 제외 (원본에는 그대로 있음)"
    done
    if [ ${#src_va[@]} -eq 0 ]; then
        echo "❌ 옮길 비디오·오디오 트랙이 없습니다."
        return 1
    fi
    [ "$chapters" -gt 0 ] && echo "   챕터 ${chapters}개"
    [ ${#hvc1[@]} -gt 0 ] && echo "   ℹ️ HEVC는 Apple 호환 태그(hvc1)로 저장합니다."

    # --- 변환: 스트림 복사 ---
    # 화면에는 진행률과 오류만 보이고, 경고는 FFREPORT 로그로 받아 아래에서 추려 보여 준다.
    local log="$work_dir/ffmpeg.log"
    partial="$dir/.${out##*/}.partial-$$"
    FFREPORT="file=$log:level=24" ffmpeg -hide_banner -nostdin -n -v error -stats \
        -i "file:$in" "${maps[@]}" "${covers[@]}" \
        -c copy -copyinkf -map_metadata 0 -map_chapters 0 "${hvc1[@]}" \
        -max_muxing_queue_size 4096 \
        -f mp4 "file:$partial"
    if [ $? -ne 0 ]; then
        if grep -q 'not currently supported in container' "$log"; then
            echo "❌ 변환 실패: MP4에 담을 수 없는 코덱이 있습니다. MOV 컨테이너를 쓰거나 재인코딩이 필요합니다."
        else
            echo "❌ 변환 실패 (위 ffmpeg 오류 참고)"
        fi
        discard_partial
        return 1
    fi

    # 로그의 첫 두 줄은 명령행이다. 데이터와 무관한 안내성 경고는 뺀다.
    local warnings count
    warnings=$(sed '1,2d' "$log" | grep -vE "$FFMPEG_BENIGN")
    if [ -n "$warnings" ]; then
        count=$(printf '%s\n' "$warnings" | grep -c .)
        printf '%s\n' "$warnings" | head -n 5 | sed 's/^/   ffmpeg: /'
        [ "$count" -gt 5 ] && echo "   ffmpeg: … (경고 총 ${count}건)"
    fi
    if grep -qiE 'non[- ]?monoton|invalid (dts|pts)|timestamps are unset' "$log"; then
        echo "   ⚠️ 원본 타임스탬프 일부가 비정상이라 ffmpeg가 보정했습니다."
        warned=1
    fi

    local dropped
    dropped=$(awk 'FILENAME == ARGV[1] { kept[tolower($0)] = 1; next }
                   !(tolower($0) in kept) { printf "%s%s", (n++ ? ", " : ""), $0 }' \
              <(global_tag_keys "$partial") <(global_tag_keys "$in"))
    if [ -n "$dropped" ]; then
        echo "   ⚠️ MP4 표준에 없는 태그라 옮기지 못함: $dropped (원본에는 그대로 있음)"
        warned=1
    fi

    # --- 검증 ---
    echo "🔍 검증: 원본과 결과물의 트랙 데이터를 비교합니다..."
    local dst_va=() dst_covers=()
    while IFS='|' read -r idx kind codec pic lang fname; do
        case "$kind:$pic" in
            video:1)         dst_covers+=("$idx") ;;
            video:*|audio:*) dst_va+=("$idx") ;;
        esac
    done <<< "$(probe_streams "$partial")"
    if [ ${#dst_va[@]} -ne ${#src_va[@]} ] || [ ${#dst_covers[@]} -ne ${#src_covers[@]} ]; then
        echo "❌ 검증 실패: 결과물의 트랙 수가 원본과 다릅니다 → 결과물을 삭제했습니다."
        discard_partial
        return 1
    fi

    # 일반 트랙 다음에 커버 순서로 짝지어 비교한다
    local src_ids=("${src_va[@]}" "${src_covers[@]}") dst_ids=("${dst_va[@]}" "${dst_covers[@]}")
    local src_hash dst_hash
    if ! src_hash=$(stream_hashes copy in "$in" "${src_ids[@]}") ||
       ! dst_hash=$(stream_hashes copy out "$partial" "${dst_ids[@]}"); then
        echo "❌ 검증 실패: 해시를 계산하지 못했습니다 → 결과물을 삭제했습니다."
        discard_partial
        return 1
    fi

    local src_lines=() dst_lines=() line k bad=0 decoded=0 src_dec dst_dec
    while IFS= read -r line; do src_lines+=("$line"); done <<< "$src_hash"
    while IFS= read -r line; do dst_lines+=("$line"); done <<< "$dst_hash"
    for ((k = 0; k < ${#src_ids[@]}; k++)); do
        [ -n "${src_lines[k]}" ] && [ "${src_lines[k]}" = "${dst_lines[k]}" ] && continue
        # 패킷 형식만 다를 수 있다 (예: MPEG-TS의 H.264·AAC). 디코딩한 결과로 다시 비교한다.
        if [ "$k" -lt ${#src_va[@]} ]; then
            echo "   트랙 #${src_ids[k]}: 패킷 형식이 달라 디코딩한 결과로 비교합니다 (시간이 걸릴 수 있음)"
            src_dec=$(stream_hashes decode in "$in" "${src_ids[k]}")
            dst_dec=$(stream_hashes decode out "$partial" "${dst_ids[k]}")
            if [ -n "$src_dec" ] && [ "$src_dec" = "$dst_dec" ]; then
                decoded=$((decoded + 1))
                continue
            fi
        fi
        echo "   ❌ 트랙 #${src_ids[k]}: 데이터가 원본과 다릅니다"
        bad=$((bad + 1))
    done
    if [ "$bad" -gt 0 ]; then
        echo "❌ 검증 실패 → 결과물을 삭제했습니다. 원본은 그대로입니다."
        discard_partial
        return 1
    fi
    if [ "$decoded" -eq 0 ]; then
        echo "   ✅ 트랙 데이터가 원본과 비트 단위로 동일 (${#src_ids[@]}개)"
    else
        echo "   ✅ 트랙 데이터가 원본과 동일 (${#src_ids[@]}개 중 ${decoded}개는 디코딩 결과로 확인)"
    fi

    if [ ${#src_va[@]} -gt 1 ]; then
        local drift
        drift=$(sync_drift_ms "$in" "$partial" "${src_va[*]}" "${dst_va[*]}")
        if [ "${drift:-0}" -gt 2 ]; then
            echo "   ⚠️ 트랙 간 시작 시각이 원본과 최대 ${drift}ms 어긋났습니다. 싱크를 확인하세요."
            warned=1
        else
            echo "   ✅ 트랙 간 싱크가 원본과 동일"
        fi
    fi

    # --- 마무리 ---
    [ -e "$out" ] && out=$(unique_path "$dir" "$name" mp4)   # 그 사이 같은 이름이 생긴 경우
    mv -n -- "$partial" "$out"
    if [ -e "$partial" ]; then
        echo "❌ 결과물 이름을 바꾸지 못했습니다. 임시 파일로 남겨 둡니다: $partial"
        partial=
        return 1
    fi
    partial=
    copy_file_info "$in" "$out"

    local outbase=${out##*/} ext sub_out
    outbase=${outbase%.mp4}
    for item in "${subs[@]}"; do
        IFS=: read -r idx codec lang <<< "$item"
        case "$codec" in
            subrip)            ext=srt ;;
            webvtt)            ext=vtt ;;
            hdmv_pgs_subtitle) ext=sup ;;
            *)                 ext=$codec ;;   # ass, ssa
        esac
        sub_out=$(unique_path "$dir" "$outbase.$lang" "$ext")
        if ffmpeg -nostdin -v error -n -i "file:$in" -map "0:$idx" -c copy "file:$sub_out"; then
            copy_file_info "$in" "$sub_out"
            echo "   📝 자막 저장: ${sub_out##*/}"
        else
            rm -f -- "$sub_out"
            echo "   ⚠️ 자막 #$idx 저장 실패"
            warned=1
        fi
    done

    echo "✅ 변환 완료: $out"
    [ "$warned" -eq 0 ] || return 2
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi
case "$1" in
    -h|--help) usage; exit 0 ;;
esac
for cmd in ffmpeg ffprobe; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "❌ $cmd 이(가) 필요합니다. 설치: brew install ffmpeg"
        exit 1
    fi
done

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/convert_mp4.XXXXXX") || exit 1
partial=
cleanup() {
    [ -n "$partial" ] && rm -f -- "$partial"
    rm -rf -- "$work_dir"
}
trap cleanup EXIT
trap 'echo; echo "⛔ 중단되었습니다."; exit 130' INT TERM

ok=0 warn=0 fail=0
for f in "$@"; do
    convert_one "$f"
    case $? in
        0) ok=$((ok + 1)) ;;
        2) ok=$((ok + 1)); warn=$((warn + 1)) ;;
        *) fail=$((fail + 1)) ;;
    esac
    [ $# -gt 1 ] && echo
done
if [ $# -gt 1 ]; then
    echo "=== 전체 $#개: 성공 ${ok}개 (경고 ${warn}개), 실패 ${fail}개 ==="
fi
[ "$fail" -eq 0 ]
